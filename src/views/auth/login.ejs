<h1 class="page-title">Entrar</h1>
<p class="page-subtitle">Acesse sua conta para participar da comunidade.</p>

<div class="detail-body">
  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <form method="POST" action="/entrar" class="form-stack">
    <div class="form-group">
      <label for="email">E-mail</label>
      <input type="email" id="email" name="email" value="<%= form.email || '' %>" required>
    </div>
    <div class="form-group">
      <label for="password">Senha</label>
      <input type="password" id="password" name="password" required>
    </div>
    <button type="submit" class="btn">Entrar</button>
  </form>

  <p style="margin-top: 16px; color: var(--color-white-dim);">
    Ainda não tem conta? <a href="/cadastrar">Criar conta</a>
  </p>
</div>