<h1 class="page-title">Oportunidades</h1>
<p class="page-subtitle">Oportunidades abertas para a cena independente.</p>

<% if (opportunities.length === 0) { %>
  <div class="empty-state">
    <p>Nenhuma oportunidade aberta no momento.</p>
  </div>
<% } else { %>
  <div class="card-grid">
    <% opportunities.forEach(function(opportunity) { %>
      <article class="card">
        <div class="card-meta">
          <%= opportunity.category %>
          <% if (opportunity.deadline) { %> · Inscrições até <%= new Date(opportunity.deadline).toLocaleDateString('pt-BR') %><% } %>
        </div>
        <h2 class="card-title"><%= opportunity.title %></h2>
        <p class="card-desc"><%= opportunity.description %></p>
        <div>
          <span class="badge badge-<%= opportunity.status %>"><%= opportunity.status %></span>
        </div>
        <a class="card-link" href="/oportunidades/<%= opportunity.id %>">Ver detalhes →</a>
      </article>
    <% }) %>
  </div>
<% } %>