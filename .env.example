# ============================================
# OndaHub — Configuração de Ambiente
# ============================================
# Copie este arquivo para `.env` e ajuste os valores.
# A aplicação funciona apenas alterando estas configurações.

# --- Banco de Dados ---
# Driver suportado: sqlite | postgres | mysql | mariadb
DATABASE_DRIVER=sqlite

# SQLite (padrão para desenvolvimento local)
DATABASE_STORAGE=./data/ondahub.sqlite

# PostgreSQL / MySQL / MariaDB (ambiente web)
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=ondahub
DATABASE_USER=
DATABASE_PASSWORD=

# --- Servidor ---
PORT=3000

# --- Autenticação ---
# Segredo da sessão (troque em produção por um valor forte)
SESSION_SECRET=ondahub-dev-secret
